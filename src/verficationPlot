import re
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# paths
BASE_DIR = Path(__file__).resolve().parent
PROJECT_DIR = BASE_DIR.parent
DATA_DIR = PROJECT_DIR / "Data"
RESULTS_DIR = PROJECT_DIR / "Results"
METHOD = "sax"
INPUT_DIR = DATA_DIR / "8-LoggedData" / "quries" / METHOD
OUTPUT_DIR = RESULTS_DIR / "Heatmaps" / METHOD
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# load results
input_file = INPUT_DIR / "sax-temp-qurires.csv"
with open(input_file, newline='', encoding='utf-8') as f:
    sample = f.read(4096)
    f.seek(0)
    delimiter = __import__('csv').Sniffer().sniff(sample, delimiters=';,').delimiter

df = pd.read_csv(input_file, sep=delimiter)
df['Config'] = df['Config'].astype(str)

# query selection
selected_cols = {
    'E2': 'E<> SPIKE',
    'A[]1': 'A[] temp range',
    'A[]2': 'A[] not deadlock',
    'P7': 'Pr <> (STABILIZED && temp range)',
    'P8': 'Pr <> (SPIKE_seen && STABILIZED)',
}

# helpers


def make_short_config(config: str) -> str:
    if pd.isna(config):
        return ''
    match = re.search(r"(\d+)trace.*?-s(\d+).*?-w(\d+)", config)
    if match:
        return f"{match.group(1)}t-s{match.group(2)}-w{match.group(3)}"
    match = re.search(r"(\d+)trace.*?-s(\d+)", config)
    if match:
        return f"{match.group(1)}t-s{match.group(2)}"
    return config


def parse_boolean(value):
    if pd.isna(value):
        return np.nan
    text = str(value).strip()
    if text in {'1', '1.0', 'True', 'true', 'TRUE'}:
        return 100.0
    if text in {'0', '0.0', 'False', 'false', 'FALSE'}:
        return 0.0
    try:
        number = float(text)
    except ValueError:
        return np.nan
    return 100.0 if number >= 0.5 else 0.0


def parse_pr_value(value):
    if pd.isna(value):
        return np.nan, ''
    text = str(value).strip()
    prefix = ''
    if text.startswith('>='):
        prefix = '>='
        text = text[2:].strip()
    elif text.startswith('>'):
        prefix = '>'
        text = text[1:].strip()
    elif text.startswith('<='):
        prefix = '<='
        text = text[2:].strip()
    elif text.startswith('<'):
        prefix = '<'
        text = text[1:].strip()
    if '+/-' in text:
        text = text.split('+/-')[0].strip()
    text = text.replace(' ', '')
    try:
        number = float(text)
    except ValueError:
        return np.nan, ''
    value = number * 100.0 if number <= 1.0 else number
    return value, prefix


def format_value(col_key, value, prefix=''):
    if np.isnan(value):
        return ''
    if col_key in {'E2', 'A[]1', 'A[]2'}:
        return '✓' if value >= 50 else '✕'
    if value < 1:
        text = f"{value:.2f}%"
    elif value < 10:
        text = f"{value:.1f}%"
    else:
        text = f"{value:.0f}%"
    return f"{prefix}{text}" if prefix else text


def value_color(value):
    if np.isnan(value):
        return '#ffffff'
    return '#4caf50' if value >= 50 else '#f44336'


def save_table(subset: pd.DataFrame, window_value: int):
    if subset.empty:
        print(f"No rows found for w{window_value}")
        return

    display_df = subset.copy()
    display_df['Variant'] = display_df['Config'].map(make_short_config)
    data_cols = list(selected_cols.keys())
    display_df = display_df[['Variant'] + data_cols]

    for col in ['E2', 'A[]1', 'A[]2']:
        display_df[f'{col}_num'] = display_df[col].apply(parse_boolean)
        display_df[f'{col}_prefix'] = ''
    for col in ['P7', 'P8']:
        display_df[[f'{col}_num', f'{col}_prefix']] = pd.DataFrame(
            display_df[col].apply(parse_pr_value).tolist(), index=display_df.index)

    table_data = [
        [row['Variant']] +
        [format_value(col, row[f'{col}_num'], row[f'{col}_prefix'])
         for col in data_cols]
        for _, row in display_df.iterrows()
    ]
    col_labels = ['Variant'] + list(selected_cols.values())

    fig_height = max(2.4, len(display_df) * 0.35 + 1.0)
    fig_width = max(12, len(col_labels) * 3.0)
    fig, ax = plt.subplots(figsize=(fig_width, fig_height))
    ax.axis('off')

    table = ax.table(
        cellText=table_data,
        colLabels=col_labels,
        cellLoc='center',
        loc='center'
    )

    for cell in table.get_celld().values():
        cell.set_linewidth(0)

    try:
        table.auto_set_column_width(col=list(range(len(col_labels))))
    except Exception:
        pass

    table.auto_set_font_size(False)
    table.set_fontsize(9)
    table.scale(1.2, 1.6)

    for j in range(len(col_labels)):
        cell = table[(0, j)]
        cell.set_facecolor('#1f3b5b')
        cell.set_text_props(color='white', weight='bold')

    for i in range(1, len(table_data) + 1):
        for j in range(len(col_labels)):
            cell = table[(i, j)]
            if j == 0:
                cell.set_facecolor('#f1f4f8')
                cell.set_text_props(color='black')
                continue

            col_key = data_cols[j - 1]
            value = display_df.iloc[i - 1][f'{col_key}_num']
            cell.set_facecolor(value_color(value))
            cell.set_text_props(weight='bold', color='white')

    title = f"UPPAAL query table — {METHOD} w{window_value}"
    ax.text(0.5, 1.02, title, transform=ax.transAxes,
            ha='center', va='bottom', fontsize=14, weight='bold')

    output_path = OUTPUT_DIR / f"uppaal_table_w{window_value}.svg"
    fig.savefig(output_path, dpi=300, bbox_inches='tight')
    plt.close(fig)
    print(f"Saved: {output_path}")

window_matches = df['Config'].astype(str).str.extract(r'-w(\d+)', expand=False)
window_values = sorted({int(x) for x in window_matches.dropna().unique()})
if window_values:
    for window in [24, 48]:
        subset = df[df['Config'].str.contains(f'w{window}\\b')].copy()
        save_table(subset, window)
else:
    print("No w24/w48 values found in Config. Saving a single persist table.")
    save_table(df, 'all')
