		<name>TagObserver</name>
		<declaration>
clock cl_observer,cl_spike,cl_flat;
bool SPIKE_seen = false;
		</declaration>
			<location id="id71" x="0" y="0">
				<name x="0" y="-20">START</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 0</label>
			<location id="id72" x="300" y="300">
				<name x="300" y="280">FLAT</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 1</label>
			<location id="id73" x="900" y="0">
