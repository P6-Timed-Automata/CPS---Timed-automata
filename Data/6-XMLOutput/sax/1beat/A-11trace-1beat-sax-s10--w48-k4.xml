		<query>
		</query>

		<query>
			<formula>E&lt;&gt; Automaton.S2 || Automaton.S23 || Automaton.S4 || Automaton.S5 || Automaton.S32 || Automaton.S94 || Automaton.S13 || Automaton.S50</formula>
