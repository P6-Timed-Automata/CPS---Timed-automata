	<queries>

		<query>
			<formula>simulate [&lt;=275; 10000] { temp } </formula>
			<comment>Generate simulation traces of the temperature signal for visual inspection of spike and flat behavior</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>E&lt;&gt; Automaton.S7</formula>
			<comment>Check that the model can reach an accepting state</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Verify that at least one spike event is possible</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.FLAT &amp;&amp; Observer.SPIKE_seen</formula>
			<comment>Verify that the system can return to a flat region after a spike</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.FLAT &amp;&amp; !Observer.SPIKE_seen</formula>
			<comment>Verify that a flat region can exist before the first spike</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.FLAT &amp;&amp; !Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window</formula>
			<comment>Check that the initial flat region lasts at least flat_window time units</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.FLAT &amp;&amp; Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window</formula>
			<comment>Check that the recovery flat region after a spike lasts at least flat_window time units</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE &amp;&amp; Observer.cl_spike &gt;= spike_window</formula>
			<comment>Check that a spike can last at least spike_window time units</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A[] not deadlock</formula>
			<comment>Ensure that the model is deadlock-free in all reachable states</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A&lt;&gt; Automaton.S7</formula>
			<comment>Check that the model can reach an accepting state for all paths</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE</formula>
			<comment>Every execution eventually reaches a spike</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.FLAT &amp;&amp; Observer.SPIKE_seen</formula>
			<comment>Every execution eventually goes through a spike and reaches a recovery flat</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.FLAT &amp;&amp; !Observer.SPIKE_seen</formula>
			<comment>Every execution eventually reaches an initial flat before spike</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.FLAT &amp;&amp; !Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window</formula>
			<comment>Every execution eventually has initial flat lasting at least flat_window</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.FLAT &amp;&amp; Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window</formula>
			<comment>Every execution eventually has recovery flat lasting at least flat_window</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE &amp;&amp; Observer.cl_spike &gt;= spike_window</formula>
			<comment>Every execution eventually has a spike lasting at least spike_window</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Automaton.S7)) </formula>
			<comment>Probability that accept state reached during the simulation time</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.SPIKE)) </formula>
			<comment>Probability that at least one spike occurs within the simulation time</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.FLAT &amp;&amp; Observer.SPIKE_seen)) </formula>
			<comment>Probability that a full cycle (flat->spike->flat) occurs</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.FLAT &amp;&amp; !Observer.SPIKE_seen)) </formula>
			<comment>Probability that an initial flat region occurs before any spike</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.FLAT &amp;&amp; Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window)) </formula>
			<comment>Probability that flat region lasts at least flat_window time units after a spike</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.FLAT &amp;&amp; !Observer.SPIKE_seen &amp;&amp; Observer.cl_flat &gt;= flat_window)) </formula>
			<comment>Probability that flat region lasts at least flat_window time units before a spike</comment>
		</query>

		<query>
			<formula>Pr[&lt;=275; 10000] (&lt;&gt; (Observer.SPIKE &amp;&amp; Observer.cl_spike &gt;= spike_window)) </formula>
			<comment>Probability that spike lasts at least spike_window time units</comment>
		</query>

