				<name x="0" y="-20">START</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 0</label>
			<location id="id46" x="300" y="300">
				<name x="300" y="280">FLAT</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 1</label>
			<location id="id47" x="900" y="0">
				<name x="900" y="-20">SPIKE</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 1</label>
		<init ref="id45"/>
		<transition>
			<source ref="id45"/>
			<target ref="id46"/>
			<label kind="guard">(temp &lt;= flat_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id46"/>
			<target ref="id46"/>
			<label kind="guard">(temp &lt;= flat_threshold &amp;&amp; cl_observer &gt;= 1 ) </label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id46"/>
			<target ref="id47"/>
			<label kind="guard">(temp &gt;= spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0,SPIKE_seen = true</label>
		</transition>
		<transition>
			<source ref="id47"/>
			<target ref="id47"/>
			<label kind="guard">(temp &gt;= spike_threshold) &amp;&amp; cl_observer &gt;= 1</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id47"/>
			<target ref="id46"/>
			<label kind="guard">(temp &lt;= flat_threshold)</label>
			<label kind="assignment">cl_observer = 0,cl_flat = 0, cl_spike = 0</label>
		</transition>
	</template>
	<system>
Automaton = TagModel();
Observer = TagObserver();
system Automaton, Observer;
	</system>
	<queries>

