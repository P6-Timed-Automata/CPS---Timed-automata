	<queries>

		<query>
			<formula>simulate [&lt;=86400; 10000] { temp } </formula>
			<comment>Simulate temperature traces over bounded time horizon to visually inspect spike events and stabilization behavior</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>E&lt;&gt;(temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Ensure there exist temperature that remains within safe operating bounds </comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether a spike state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABLE</formula>
			<comment>Check whether a stable state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABLE &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether a stable state is reachable in at least one execution path in temp range</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABILIZED</formula>
			<comment>Check whether the system can reach a stabilized state in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether the system can reach a stabilized state in at least one execution path in temp range</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED</formula>
