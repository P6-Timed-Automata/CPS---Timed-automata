		<query>
		</query>

		<query>
			<formula>E&lt;&gt;(temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Ensure there exist temperature that remains within safe operating bounds </comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether a spike state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABLE</formula>
			<comment>Check whether a stable state is reachable in at least one execution path</comment>
		</query>

