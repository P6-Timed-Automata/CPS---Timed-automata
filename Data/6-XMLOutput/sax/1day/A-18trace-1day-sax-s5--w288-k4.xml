	<system>
Automaton = TagModel();
Observer = TagObserver();
system Automaton, Observer;
	</system>
	<queries>

		<query>
			<formula>simulate [&lt;=86400; 10000] { temp } </formula>
			<comment>Simulate temperature traces over bounded time horizon to visually inspect spike events and stabilization behavior</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>E&lt;&gt;(temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Ensure there exist temperature that remains within safe operating bounds </comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether a spike state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABLE</formula>
			<comment>Check whether a stable state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABLE &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether a stable state is reachable in at least one execution path in temp range</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABILIZED</formula>
			<comment>Check whether the system can reach a stabilized state in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether the system can reach a stabilized state in at least one execution path in temp range</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED</formula>
			<comment>Check whether there exists a run where a spike occurs and stabilization is eventually reached afterward</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether there exists a run where a spike occurs and stabilization is eventually reached afterward in temp range</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A[] (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Ensure temperature always remains within safe operating bounds in all states</comment>
		</query>

		<query>
			<formula>A[] not deadlock</formula>
			<comment>Ensure the system is deadlock-free in all reachable states</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A&lt;&gt; Automaton.S1 || Automaton.S3 || Automaton.S2 || Automaton.S63</formula>
			<comment>Check that the model can reach an accepting state for all paths</comment>
		</query>

		<query>
			<formula>A&lt;&gt; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Ensure temperature  remains within safe operating bounds </comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether spike eventually occurs on all execution paths (liveness requirement)</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.STABLE</formula>
			<comment>Check whether spike eventually occurs on all execution paths (liveness requirement)</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.STABLE &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether spike eventually occurs on all execution paths in temp range(liveness requirement)</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.STABILIZED</formula>
			<comment>Check whether all executions eventually reach a stabilized state</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether all executions eventually reach a stabilized state in temp range</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED</formula>
			<comment>Check whether all executions eventually include both spike occurrence and subsequent stabilization</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)</formula>
			<comment>Check whether all executions eventually include both spike occurrence and subsequent stabilization in temp range</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000] (&lt;&gt; (Automaton.S1 || Automaton.S3 || Automaton.S2 || Automaton.S63)) </formula>
			<comment>Probability that accept state reached during the simulation time</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; ((temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)))</formula>
			<comment>Compute probability that a temperature occurs within the given temp range</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; Observer.SPIKE)</formula>
			<comment>Compute probability that a spike occurs within the given time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; Observer.STABLE)</formula>
			<comment>Compute probability that a stable occurs within the given time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; (Observer.STABLE &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)))</formula>
			<comment>Compute probability that a stable occurs within the given time bound in temp range</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; Observer.STABILIZED)</formula>
			<comment>Compute probability that the system stabilizes within the given time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; (Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)))</formula>
			<comment>Compute probability that the system stabilizes within the given time bound in temp range</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; (Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED))</formula>
			<comment>Compute probability that a spike occurs followed by stabilization within the time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 10000](&lt;&gt; (Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max)))</formula>
			<comment>Compute probability that a spike occurs followed by stabilization within the time bound in temp range</comment>
		</query>

