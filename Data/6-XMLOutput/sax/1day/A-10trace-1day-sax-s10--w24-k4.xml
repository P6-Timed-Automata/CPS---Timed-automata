			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id33"/>
			<target ref="id34"/>
			<label kind="guard">cl_observer &gt;= stabilization_time</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
