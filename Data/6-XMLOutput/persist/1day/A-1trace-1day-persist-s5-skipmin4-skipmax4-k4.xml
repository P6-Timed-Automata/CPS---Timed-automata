<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
<declaration>
clock cl_local, cl_global;
const int a = 1696;
const int b = 1759;
const int c = 1829;
const int d = 2248;
const int e = 2848;
 
int temp = d;
int prev_temp;
const int spike_threshold = 4000;
const int temp_min = 1800; 
const int temp_max = 2700;
const int stabilization_time = 900;
</declaration>
	<template>
		<name x="5" y="5">TagModel</name>
		<declaration>
		</declaration>
			<location id="id0" x="223" y="-636">
				<name x="223" y="-656">S0</name>
				<label kind="invariant">cl_local&lt;=86100</label>
			</location>
			<location id="id1" x="223" y="-115">
				<name x="223" y="-135">S1</name>
				<label kind="invariant">cl_local &lt;= 0</label>
			</location>
			<init ref="id0"/>
		<transition>
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="guard">
cl_local &gt;= 86100 &amp;&amp; cl_local &lt;= 86100			</label>
			<label kind="assignment">
prev_temp = temp,
temp = d,
cl_local = 0
			</label>
		</transition>
		<transition>
			<source ref="id1"/>
			<target ref="id0"/>
			<label kind="assignment">cl_local = 0</label>
		</transition>
	</template>	<template>
		<name>TagObserver</name>
		<declaration>
			clock cl_observer;
			bool SPIKE_seen = false;
		</declaration>
			<location id="id2" x="0" y="0">
				<name x="0" y="-20">START</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 0</label>
			<location id="id3" x="200" y="50">
				<name x="200" y="30">SPIKE</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 90000</label>
			<location id="id4" x="400" y="-50">
				<name x="400" y="-70">STABLE</name>
			</location>
		<label kind="invariant">cl_observer &lt;= stabilization_time</label>
			<location id="id5" x="600" y="100">
				<name x="600" y="80">STABILIZED</name>
			</location>
		<label kind="invariant">cl_observer &lt;= 90000</label>
		<init ref="id2"/>
		<transition>
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard">((temp - prev_temp &gt;= spike_threshold) || (prev_temp - temp &gt;= spike_threshold))</label>
			<label kind="assignment">cl_observer = 0,SPIKE_seen = true</label>
		</transition>
		<transition>
			<source ref="id2"/>
			<target ref="id4"/>
			<label kind="guard">((temp - prev_temp &lt; spike_threshold) &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max))</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="guard">((temp - prev_temp &lt; spike_threshold) &amp;&amp; (temp &gt;= temp_min) &amp;&amp; (temp &lt;= temp_max))</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="guard">cl_observer &gt;= stabilization_time</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id4"/>
			<target ref="id3"/>
			<label kind="guard">((temp - prev_temp &gt;= spike_threshold) || (prev_temp - temp &gt;= spike_threshold))</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id5"/>
			<target ref="id3"/>
			<label kind="guard">((temp - prev_temp &gt;= spike_threshold) || (prev_temp - temp &gt;= spike_threshold))</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
	</template>
	<system>
Automaton = TagModel();
Observer = TagObserver();
system Automaton, Observer;
	</system>
	<queries>

		<query>
			<formula>simulate [&lt;=86400; 1] { temp } </formula>
			<comment>Simulate temperature traces over bounded time horizon to visually inspect spike events and stabilization behavior</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether a spike state is reachable in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.STABILIZED</formula>
			<comment>Check whether the system can reach a stabilized state in at least one execution path</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED</formula>
			<comment>Check whether there exists a run where a spike occurs and stabilization is eventually reached afterward</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A[] (temp &gt;= temp_min &amp;&amp; temp &lt;= temp_max)</formula>
			<comment>Ensure temperature always remains within safe operating bounds in all states</comment>
		</query>

		<query>
			<formula>A[] not deadlock</formula>
			<comment>Ensure the system is deadlock-free in all reachable states</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE</formula>
			<comment>Check whether spike eventually occurs on all execution paths (liveness requirement)</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.STABILIZED</formula>
			<comment>Check whether all executions eventually reach a stabilized state</comment>
		</query>

		<query>
			<formula>A&lt;&gt; Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED</formula>
			<comment>Check whether all executions eventually include both spike occurrence and subsequent stabilization</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 1](&lt;&gt; Observer.SPIKE)</formula>
			<comment>Compute probability that a spike occurs within the given time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 1](&lt;&gt; Observer.STABILIZED)</formula>
			<comment>Compute probability that the system stabilizes within the given time bound</comment>
		</query>

		<query>
			<formula>Pr[&lt;=86400; 1](&lt;&gt; (Observer.SPIKE_seen &amp;&amp; Observer.STABILIZED))</formula>
			<comment>Compute probability that a spike occurs followed by stabilization within the time bound</comment>
		</query>

	</queries>
</nta>