		<query>
		</query>

		<query>
			<formula>E&lt;&gt; Automaton.S88 || Automaton.S89 || Automaton.S87 || Automaton.S15</formula>
			<comment>Check that the model can reach an accepting state</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.SPIKE</formula>
			<comment>Verify that at least one spike event is possible</comment>
		</query>

		<query>
			<formula>E&lt;&gt; Observer.FLAT &amp;&amp; Observer.SPIKE_seen</formula>
