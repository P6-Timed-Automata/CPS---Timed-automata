			<source ref="id21"/>
			<target ref="id22"/>
			<label kind="guard">(temp &lt;= flat_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id22"/>
			<target ref="id22"/>
			<label kind="guard">(temp &lt;= flat_threshold) &amp;&amp; (cl_observer &gt;= 3) </label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id22"/>
			<target ref="id24"/>
			<label kind="guard">(temp &gt;= spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0,SPIKE_seen = true</label>
		</transition>
		<transition>
			<source ref="id22"/>
			<target ref="id23"/>
			<label kind="guard">(temp &gt; flat_threshold)  &amp;&amp; (temp &lt; spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id23"/>
			<target ref="id23"/>
			<label kind="guard">(temp &gt; flat_threshold)  &amp;&amp; (temp &lt; spike_threshold) &amp;&amp; (cl_observer &gt;= 3 )</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id23"/>
			<target ref="id22"/>
			<label kind="guard">temp &lt;= flat_threshold</label>
			<label kind="assignment">cl_observer = 0, cl_spike = 0</label>
		</transition>
