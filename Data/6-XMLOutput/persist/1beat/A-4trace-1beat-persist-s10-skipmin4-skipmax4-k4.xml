		<init ref="id43"/>
		<transition>
			<source ref="id43"/>
			<target ref="id44"/>
			<label kind="guard">(temp &lt;= flat_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id44"/>
			<target ref="id44"/>
			<label kind="guard">(temp &lt;= flat_threshold) &amp;&amp; (cl_observer &gt;= 3) </label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id44"/>
			<target ref="id46"/>
			<label kind="guard">(temp &gt;= spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, cl_spike = 0,SPIKE_seen = true</label>
		</transition>
		<transition>
			<source ref="id44"/>
			<target ref="id45"/>
			<label kind="guard">(temp &gt; flat_threshold)  &amp;&amp; (temp &lt; spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id45"/>
			<target ref="id45"/>
			<label kind="guard">(temp &gt; flat_threshold)  &amp;&amp; (temp &lt; spike_threshold) &amp;&amp; (cl_observer &gt;= 3 )</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id45"/>
			<target ref="id44"/>
			<label kind="guard">temp &lt;= flat_threshold</label>
			<label kind="assignment">cl_observer = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id45"/>
			<target ref="id46"/>
			<label kind="guard"> temp &gt;= spike_threshold</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0, SPIKE_seen = true</label>
		</transition>
		<transition>
			<source ref="id46"/>
			<target ref="id46"/>
			<label kind="guard">(temp &gt;= spike_threshold) &amp;&amp; ( cl_observer &gt;= 3)</label>
			<label kind="assignment">cl_observer = 0</label>
		</transition>
		<transition>
			<source ref="id46"/>
			<target ref="id44"/>
			<label kind="guard">(temp &lt;= flat_threshold)</label>
			<label kind="assignment">cl_observer = 0,cl_flat = 0, cl_spike = 0</label>
		</transition>
		<transition>
			<source ref="id46"/>
			<target ref="id45"/>
			<label kind="guard"> (temp &gt; flat_threshold)  &amp;&amp; (temp &lt; spike_threshold)</label>
			<label kind="assignment">cl_observer = 0, cl_flat = 0</label>
		</transition>
	</template>
	<system>
Automaton = TagModel();
Observer = TagObserver();
system Automaton, Observer;
	</system>
	<queries>

		<query>
			<formula>simulate [&lt;=275; 10000] { temp } </formula>
