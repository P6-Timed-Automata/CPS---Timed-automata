			<formula>simulate [&lt;=275; 10000] { temp } </formula>
			<comment>Generate simulation traces of the temperature signal for visual inspection of spike and flat behavior</comment>
		</query>

		<query>
		</query>

		<query>
			<formula>E&lt;&gt; Automaton.S1 || Automaton.S38 || Automaton.S44 || Automaton.S10 || Automaton.S5 || Automaton.S163 || Automaton.S6 || Automaton.S15 || Automaton.S7 || Automaton.S166</formula>
